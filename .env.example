# Copy to .env and adjust. Every service validates its own variables at startup (Zod).
NODE_ENV=development
LOG_LEVEL=debug

# ── Web app ──
APP_URL=http://localhost:3000
# openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# ── PostgreSQL (docker compose maps 5433 to avoid clashing with a local Postgres) ──
DATABASE_URL=postgresql://devsync:devsync@localhost:5433/devsync
DATABASE_URL_TEST=postgresql://devsync:devsync@localhost:5433/devsync_test

# ── Redis ──
REDIS_URL=redis://localhost:6380

# ── Object storage (MinIO locally, any S3-compatible provider in production) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=devsync-dev
S3_ACCESS_KEY_ID=devsync
S3_SECRET_ACCESS_KEY=devsync-secret
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit locally) ──
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="DevSync AI <no-reply@devsync.local>"

# ── Realtime gateway ──
REALTIME_PORT=4000
REALTIME_URL=http://localhost:4000
# Shared secret used by the web app to sign short-lived realtime tokens (HS256).
REALTIME_JWT_SECRET=change-me-to-another-random-string-32-chars-min

# Emails with access to the platform admin console (/admin); the address must be verified
PLATFORM_ADMIN_EMAILS=
