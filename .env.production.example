# DevSync AI — production variables (Dokploy → Environment). Generate secrets with: openssl rand -hex 32
APP_URL=https://devsync.example.com
REALTIME_URL=https://realtime.devsync.example.com

AUTH_SECRET=change-me-64-hex-chars
REALTIME_JWT_SECRET=change-me-another-64-hex-chars
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Object storage: bundled MinIO (defaults) or an external S3-compatible provider.
S3_ACCESS_KEY_ID=devsync
S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
S3_BUCKET=devsync
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true

# Email (invitations, password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="DevSync AI <no-reply@example.com>"

# Comma-separated emails with access to the platform admin console (/admin)
PLATFORM_ADMIN_EMAILS=you@example.com

# Reverse proxies in front of the app (Traefik on Dokploy = 1)
TRUSTED_PROXY_HOPS=1
# WORKER_ROLES=maintenance,embeddings
