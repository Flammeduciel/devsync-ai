{
  "name": "@devsync/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devsync/config": "workspace:*",
    "@devsync/database": "workspace:*",
    "@devsync/event-schemas": "workspace:*",
    "@devsync/protocol": "workspace:*",
    "@devsync/shared": "workspace:*",
    "@devsync/validation": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "^8.16.3",
    "pino": "10.4.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
