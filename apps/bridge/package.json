{
  "name": "@devsync/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevSync Bridge — local daemon and `devsync` CLI running on each developer machine",
  "bin": {
    "devsync": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@devsync/config": "workspace:*",
    "@devsync/event-schemas": "workspace:*",
    "@devsync/protocol": "workspace:*",
    "@devsync/sdk": "workspace:*",
    "@devsync/shared": "workspace:*",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "socket.io": "4.8.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
